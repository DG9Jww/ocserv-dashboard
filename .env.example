# User-managed settings. Leave HOST empty to use the detected server IPv4 address.
HOST=""
SECRET_KEY=""
AGENT_NODE=false
AGENT_UPSTREAM_SCHEME=https
AGENT_API_HTTPS=false
SUPERADMIN_USERNAME="admin"
SUPERADMIN_PASSWORD="admin"

OCSERV_PORT=443
OC_NET="10.10.10.0/24"
OCSERV_DNS="8.8.8.8"
OCSERV_BANNER="Welcome to the VPN service"
OCSERV_PRE_LOGIN_BANNER="Welcome"
# Set to true only to replace the mounted ocserv.conf with Docker defaults.
OCSERV_REGENERATE_CONFIG=false
SSL_CN="{HOST}"
SSL_ORG="ocserv-dashboard"
SSL_EXPIRE=3650
TLS_CERT_FILE=""
TLS_KEY_FILE=""

# Used to obtain a Let's Encrypt certificate when both TLS paths are empty.
# With all three settings empty, the installer uses a self-signed certificate.
LETSENCRYPT_EMAIL=""
ETH=""

TELEGRAM_BOT_ENABLED=true
CUSTOMER_API_ENABLED=true
# Docker Master admin URL. Use / or a single prefix such as /privatepath.
ADMIN_BASE_PATH=/

# Enable unified customers with certificate authentication. RADIUS enables them automatically.
CUSTOMER_MULTI_NODE_ENABLED=false
# Set auth = radius and enable-auth = certificate in ocserv.conf to accept both. See deploy/radius/README.md.
# Master only. Use an independent random secret of at least 32 characters.
CUSTOMER_RADIUS_REST_SECRET=
